# Copy to .env; chmod 600 .env. Generate secrets with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
DEBUG=0
SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_DB=chembig
POSTGRES_USER=chembig
POSTGRES_PASSWORD=replace-with-another-long-random-secret
ALLOWED_HOSTS=challenge.example.ac.kr,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://challenge.example.ac.kr
DATA_DIR=./var
APP_IMAGE=chembig:local
